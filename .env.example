DATABASE_URL=postgres://user:password@localhost:5432/blobby
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
ALLOWED_GITHUB_USER_IDS=12345,67890
# Set this only behind a proxy that overwrites the header with the client address.
# Without such a proxy a client can send any address. See the README.
# TRUSTED_PROXY_IP_HEADER=x-forwarded-for
# The token the game server sends as Authorization: Bearer <token>. Set a long random string,
# such as the output of `openssl rand -hex 32`. While it is empty the game server API answers 503.
GAME_SERVER_TOKEN=
